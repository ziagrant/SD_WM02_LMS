# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Replace these with your actual MySQL Workbench credentials
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=lms_db
DB_PORT=3306

# ─── Session ──────────────────────────────────────────────────────────────────
# Make this a long random string — it signs your session cookies.
# You can generate one at: https://randomkeygen.com/
SESSION_SECRET=change_this_to_a_long_random_string_before_deployment
